# Image naming for Docker Hub
DOCKERHUB_NAMESPACE=local
IMAGE_TAG=V1.0

# Service ports on host machine
FRONTEND_PORT=80
JAVA_PORT=8080
PYTHON_PORT=8000
MYSQL_PORT=3306

# Database settings
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=back_end

# Redis settings
REDIS_PORT=6379
REDIS_PASSWORD=123112
REDIS_DB=0

# Timezone
TZ=Asia/Shanghai

# Optional CORS for Python backend
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1
